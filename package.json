{
  "name": "mediasswint",
  "version": "0.0.0",
  "private": true,
  "description": "Software Interno Medias Elasticas - monorepo",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm --filter @mediasswint/web lint",
    "typecheck": "pnpm --filter @mediasswint/web typecheck",
    "build": "pnpm --filter @mediasswint/web build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "infra:dev": "docker compose --env-file .env -f docker/docker-compose.dev.yml up -d --build",
    "infra:dev:down": "docker compose --env-file .env -f docker/docker-compose.dev.yml down",
    "infra:dev:logs": "docker compose --env-file .env -f docker/docker-compose.dev.yml logs -f",
    "infra:dev:ps": "docker compose --env-file .env -f docker/docker-compose.dev.yml ps"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
